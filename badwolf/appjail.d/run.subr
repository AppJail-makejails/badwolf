
set -e -o pipefail

CLEAN_SCRIPT="/var/run/x11appjail/clean/${X11APPJAIL_JAIL}"

# jexec(8)
JEXEC="${X11APPJAIL_BASEDIR}/usr/local/libexec/appjail/jexec/jexec"

. "${X11APPJAIL_WORKDIR}/appjail.d/lib.subr"
. "${X11APPJAIL_WORKDIR}/appjail.d/dbus.subr"
. "${X11APPJAIL_WORKDIR}/appjail.d/perms.subr"

if [ -x "${CLEAN_SCRIPT}" ]; then
    # xdg-dbus-proxy may be using an old and therefore invalid D-Bus
    # address, causing applications to display error messages and fail
    # when communicating via D-Bus.

    __dbus_system_addr=
    if [ -f "${__dbus_system_addrfile}" ]; then
        __dbus_system_addr=$(
            (lockf 9 || exit 1; head -1 -- "${__dbus_system_addrfile}") 9>> "${__dbus_system_addrfile}" || exit 1
            exec 9>&-
        )
    fi

    __dbus_session_addr=
    if [ -f "${__dbus_session_addrfile}" ]; then
        __dbus_session_addr=$(
            (lockf 9 || exit 1; head -1 -- "${__dbus_session_addrfile}") 9>> "${__dbus_session_addrfile}" || exit 1
            exec 9>&-
        )
    fi

    #
    # Terminating xdg-dbus-proxy will kill the child process.
    #
    if [ "${__dbus_system_addr}" != "${X11APPJAIL_DBUS_SYSTEM_BUS_ADDRESS}" ] ||\
            [ "${__dbus_session_addr}" != "${X11APPJAIL_DBUS_SESSION_BUS_ADDRESS}" ]; then
        "${CLEAN_SCRIPT}"
    fi

    if [ -n "${X11APPJAIL_DBUS_SYSTEM_BUS_ADDRESS}" ]; then
        (
            lockf 9 || exit 1

            printf "%s\n" "${X11APPJAIL_DBUS_SYSTEM_BUS_ADDRESS}" |\
                tee "${__dbus_system_addrfile}" > /dev/null || exit 1
        ) 9>> "${__dbus_system_addrfile}"
        exec 9>&-
    fi

    if [ -n "${X11APPJAIL_DBUS_SESSION_BUS_ADDRESS}" ]; then
        (
            lockf 9 || exit 1

            printf "%s\n" "${X11APPJAIL_DBUS_SESSION_BUS_ADDRESS}" |\
                tee "${__dbus_session_addrfile}" > /dev/null || exit 1
        ) 9>> "${__dbus_session_addrfile}"
        exec 9>&-
    fi
fi

if [ -n "${__run_program}" ]; then
    set -- "${__run_program}" "$@"
fi

if ${__perms_allow_3d}; then
    VGL_DISPLAY="egl"
    ATTR="${X11APPJAIL_APPNAME}:${X11APPJAIL_PROFILE}.virtualgl.display"

    if x11appjail sys-attr check "${ATTR}" "${X11APPJAIL_UID}"; then
        VGL_DISPLAY=`x11appjail sys-attr cat "${ATTR}" "${X11APPJAIL_UID}"`
    fi

    set -- /usr/local/VirtualGL/bin/vglrun -d "${VGL_DISPLAY}" "$@"
fi

set -- "${X11APPJAIL_JAIL}" "$@"

if [ -n "${X11APPJAIL_DISPLAY}" ]; then
    set -- -e "DISPLAY=${X11APPJAIL_DISPLAY}" "$@"
fi

if [ -d "${X11APPJAIL_WORKDIR}/env.d" ]; then
    for ENV_FILE in "${X11APPJAIL_WORKDIR}/env.d"/*; do
        if [ "${ENV_FILE}" = "${X11APPJAIL_WORKDIR}/env.d/*" ]; then
            break
        fi

        ENV_NAME="${ENV_FILE##*/}"
        ENV_VALUE=`cat -- "${ENV_FILE}"`

        set -- -e "${ENV_NAME}=${ENV_VALUE}" "$@"
    done
fi

if [ "${__dbus_system_mode}" != "none" ]; then
    set -- -e "DBUS_SYSTEM_BUS_ADDRESS=unix:path=/var/run/dbus/system_bus_socket" "$@"

    start_dbus "dbus-system" "${__dbus_system_mode}" "${__dbus_system_pidfile}" "${X11APPJAIL_DBUS_SYSTEM_BUS_ADDRESS}" \
        "${__dbus_system_sock}"
fi

if [ "${__dbus_session_mode}" != "none" ]; then
    set -- -e "DBUS_SESSION_BUS_ADDRESS=unix:path=/var/run/dbus-session/session_bus_socket" "$@"

    start_dbus "dbus-user" "${__dbus_session_mode}" "${__dbus_session_pidfile}" "${X11APPJAIL_DBUS_SESSION_BUS_ADDRESS}" \
        "${__dbus_session_sock}"
fi

get_user_attrs

for USER_ATTR in ${USER_ATTRS}; do
    case "${USER_ATTR}" in
        ${X11APPJAIL_APPNAME}:${X11APPJAIL_PROFILE}.env.*) ;;
        *) continue ;;
    esac

    USER_VALUE=`x11appjail sys-attr cat "${USER_ATTR}" "${X11APPJAIL_UID}"`

    set -- -e "${USER_VALUE}" "$@"
done

exec "${JEXEC}" -l -U noroot "$@"
