ARG puid
ARG pgid
ARG from=ghcr.io/appjail-makejails/badwolf
ARG tag=latest

OPTION start
OPTION overwrite=force
OPTION from=${from}:${tag}
OPTION container=args:--pull=newer
OPTION volume=data mountpoint:/noroot owner:${puid} group:${pgid}
OPTION template=template.conf
OPTION meta=x11appjail.exec.user:noroot
OPTION x11

CMD if [ -d "/system-fonts" ]; then \
        { \
            echo -e '<?xml version="1.0"?>'; \
            echo -e '<!DOCTYPE fontconfig SYSTEM "urn:fontconfig:fonts.dtd">'; \
            echo -e '<fontconfig>'; \
            echo -e '  <dir>/system-fonts</dir>'; \
            echo -e '</fontconfig>'; \
        } > /usr/local/etc/fonts/conf.d/51-x11appjail.conf; \
        fc-cache -f; \
    fi

CMD pw groupadd -n noroot -g "${pgid}" && \
    pw useradd -n noroot -d /noroot -u "${puid}" -g "${pgid}" && \
    mkdir -p /noroot && \
    chown -R noroot:noroot /noroot

# Without devices, this is useless.
CMD pw groupmod -n video -m noroot
CMD pw groupadd -n webcamd -g 145 -M noroot

SERVICE dbus enable
SERVICE dbus start
